# Choose one provider
LLM_PROVIDER=anthropic          # anthropic | openai

ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
# Generation model. Blank/unset falls back to app/config.py's default (gpt-4.1-mini).
# Cheapest first: gpt-4.1-nano < gpt-5-nano < gpt-4.1-mini < gpt-4o-mini < gpt-4.1
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5

CHROMA_PERSIST_DIR=./chroma_store

# --- retrieval quality -------------------------------------------------
# Loose first-pass gate on vector similarity (0-1). Runs before reranking,
# so keep it low: set high it starves the reranker of candidates.
SIMILARITY_THRESHOLD=0.2
# Cross-encoder rerank of the candidate pool. Local ONNX, no API key.
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_FETCH_K=20
# Optional sharp relevance gate on the cross-encoder score (a raw logit).
# Blank = off. Calibrate on your own corpus before enabling — see README.
RERANK_SCORE_THRESHOLD=
