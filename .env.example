# Choose one provider
LLM_PROVIDER=anthropic          # anthropic | openai

ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here
# Generation model. Blank/unset falls back to app/config.py's default (gpt-4.1-mini).
# Cheapest first: gpt-4.1-nano < gpt-5-nano < gpt-4.1-mini < gpt-4o-mini < gpt-4.1
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-5

CHROMA_PERSIST_DIR=./chroma_store

# --- retrieval quality -------------------------------------------------
# Cross-encoder rerank of the candidate pool. Local ONNX, no API key.
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_FETCH_K=20
# Relevance floor for refusal, on the cross-encoder's raw logit scale: if
# the best chunk scores below this, the question is refused without an LLM
# call. Recalibrate if you change RERANK_MODEL — see README.
SIMILARITY_THRESHOLD=-8.0
